% Tailored CV template - reproduces the "engineeringresumes" look.
% Rendered by build_cv.py (Jinja2 templating) and compiled with tectonic.
\documentclass[10pt,a4paper]{article}

\usepackage[T1]{fontenc}
\usepackage{XCharter}
\usepackage[top=1.3cm,bottom=1.3cm,left=1.5cm,right=1.5cm,footskip=0.5cm]{geometry}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage{xcolor}

% "Last updated" in the top-right corner
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[R]{\footnotesize\itshape\textcolor{gray}{Last updated in << updated | e >>}}
\setlength{\headheight}{14pt}

% Section headers: bold, with a full-width rule underneath
\titleformat{\section}{\large\bfseries}{}{0em}{}[{\titlerule[0.8pt]}]
\titlespacing*{\section}{0pt}{9pt}{4pt}

% Tight bullet lists
\setlist[itemize]{leftmargin=1.15em,topsep=2pt,itemsep=1pt,parsep=0pt,label=\textbullet}
\setlength{\parindent}{0pt}
\linespread{1.04}

% Entry heading: left-hand title (may wrap) + right-aligned date, top-aligned
\newcommand{\heading}[2]{%
  \begin{minipage}[t]{0.76\linewidth}\raggedright #1\end{minipage}\hfill
  \begin{minipage}[t]{0.23\linewidth}\raggedleft #2\end{minipage}\par}

\begin{document}

% ---------- Header ----------
\begin{center}
  {\Huge << name | e >>}\\[5pt]
  \small << contact.location | e >>~~\textbar~~\href{mailto:<< contact.email >>}{<< contact.email | e >>}<% for l in contact.links %>~~\textbar~~<< l | e >><% endfor %>
\end{center}
\vspace{1pt}

% ---------- Summary ----------
<% if summary %>
\section{Summary}
<< summary | e >>
<% endif %>

% ---------- Education ----------
<% if education %>
\section{Education}
<% for ed in education %>
\heading{\textbf{<< ed.org | e >>}<% if ed.qualification %>, << ed.qualification | e >><% endif %><% if ed.location %> -- << ed.location | e >><% endif %>}{<< ed.date | e >>}
<% if ed.description %>\vspace{1pt}\par << ed.description | e >>
<% endif %>
<% if ed.bullets %>
\begin{itemize}
<% for b in ed.bullets %>  \item << b | e >>
<% endfor %>\end{itemize}
<% endif %>
<% endfor %>
<% endif %>

% ---------- Experience ----------
<% if experience %>
\section{Experience}
<% for ex in experience %>
\heading{\textbf{<< ex.role | e >>}<% if ex.org %>, << ex.org | e >><% endif %><% if ex.location %> -- << ex.location | e >><% endif %>}{<< ex.date | e >>}
<% if ex.description %>\vspace{1pt}\par << ex.description | e >>
<% endif %>
<% if ex.bullets %>
\begin{itemize}
<% for b in ex.bullets %>  \item << b | e >>
<% endfor %>\end{itemize}
<% endif %>
<% endfor %>
<% endif %>

% ---------- Projects ----------
<% if projects %>
\section{Projects}
<% for p in projects %>
\heading{\textbf{<< p.name | e >><% if p.location %> -- << p.location | e >><% endif %>}}{<< p.date | e >>}
<% if p.description %>\vspace{1pt}\par << p.description | e >>
<% endif %>
<% if p.bullets %>
\begin{itemize}
<% for b in p.bullets %>  \item << b | e >>
<% endfor %>\end{itemize}
<% endif %>
<% endfor %>
<% endif %>

% ---------- Skills ----------
<% if skills %>
\section{Skills}
<% for s in skills %>
\textbf{<< s.category | e >>:} << s['items'] | map('e') | join(' \\textperiodcentered{} ') >>\par
<% endfor %>
<% endif %>

\end{document}
