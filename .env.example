# Copy to .env and edit. Every line is optional; defaults keep data inside ./data.

# Mailbox to read job alerts from (only needed for the Gmail source).
JOBSCOUT_GMAIL=you@gmail.com

# Where finished CVs are written. Point at a notes vault if you keep one.
# JOBSCOUT_CVS=~/Documents/Notes/CVs

# Filename prefix for generated CVs. A recruiter sees this in ATS uploads,
# so keep it clean: no dates, no run metadata.
JOBSCOUT_CV_PREFIX=Jane Doe - CV -

# Your profile and preferences. Defaults to ./data/profile.md and ./data/prefs.md.
# JOBSCOUT_PROFILE=~/Documents/Notes/profile.md
# JOBSCOUT_PREFS=~/Documents/Notes/prefs.md

# Gmail labels to scan, comma separated.
JOBSCOUT_LABELS=Jobs/Listings,Jobs/Alerts

# Server port.
JOBSCOUT_PORT=7777
